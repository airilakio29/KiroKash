# KiroKash Firebase Configuration
# Copy your Firebase web app keys from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup/configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# CARTO Basemaps API Key (for high-speed Dark Matter raster tiles)
VITE_CARTO_API_KEY=your_carto_basemap_key_here

# KampusKash AI Assistant Configuration (Gemini API)
# Store in server environment or Firebase Secret Manager: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
# Optional custom backend URL (defaults to /api/ai/chat)
# VITE_AI_BACKEND_URL=https://asia-southeast1-your_project_id.cloudfunctions.net/chatFunction
