rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. Private User Finance Document (Strictly Owner-Only)
    // =========================================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // =========================================================================
    // 2. Public Social Profiles (No Financial Data Allowed)
    // =========================================================================
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.handle is string
        && request.resource.data.handle.size() >= 3
        && request.resource.data.handle.size() <= 24
        && !request.resource.data.keys().hasAny([
          'balance',
          'walletBalance',
          'budgets',
          'monthlyBudget',
          'transactions',
          'walletHistory',
          'ledger',
          'accounts',
          'savingsGoals',
          'allowance',
          'income',
          'expenses',
          'netWorth',
          'pin',
          'pinHash',
          'walletPin',
          'email',
          'password',
          'phoneNumber'
        ]);
      allow delete: if isOwner(userId);
    }

    // =========================================================================
    // 2B. Case-Insensitive Unique Username Handles (KampusKash Connect)
    // =========================================================================
    match /userHandles/{handle} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.handle == handle
        && handle.size() >= 3
        && handle.size() <= 24;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // 2C. KampusKash Connect — Friend Requests
    // =========================================================================
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && (
          (resource.data.receiverId == request.auth.uid && request.resource.data.status in ['accepted', 'rejected']) ||
          (resource.data.senderId == request.auth.uid && request.resource.data.status in ['cancelled', 'removed'])
        );

      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // =========================================================================
    // 2D. KampusKash Connect — Mutual Friendships
    // =========================================================================
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;

      allow create: if isSignedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.userA != request.resource.data.userB;

      allow update: if isSignedIn() && request.auth.uid in resource.data.users;

      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // =========================================================================
    // 3. Spot Jimat Feed (Migrated from communityThreads + spots)
    // =========================================================================
    match /communityThreads/{threadId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 8
        && request.resource.data.body.size() <= 1000
        && request.resource.data.priceRM is number
        && request.resource.data.priceRM >= 0
        && request.resource.data.priceRM <= 500;

      // Owner can edit full post; other signed-in users can only update upvotes/replyCount/updatedAt
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'replyCount', 'updatedAt'])
      );

      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Comments / Replies Subcollection
      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 2
          && request.resource.data.body.size() <= 400;
        allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      // Likes / Votes Subcollection (1 vote per user)
      match /votes/{voteUserId} {
        allow read: if true;
        allow create, update, delete: if isOwner(voteUserId);
      }
    }

    // =========================================================================
    // 4. Saved Spot Bookmarks (Strictly Private to Owner)
    // =========================================================================
    match /spotSaves/{saveId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // =========================================================================
    // 5. Social Follows
    // =========================================================================
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // =========================================================================
    // 6. User Blocks
    // =========================================================================
    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockerId != request.resource.data.blockedId;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // =========================================================================
    // 7. Notifications
    // =========================================================================
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // =========================================================================
    // 8. Community & User Moderation Reports (Append-Only)
    // =========================================================================
    match /communityReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 200;
      allow read, update, delete: if false;
    }

    // =========================================================================
    // 9. Demo KampusKash Wallets (Private Owner Read, Bounded Atomic Updates)
    // =========================================================================
    match /wallets/{userId} {
      allow read: if isOwner(userId);

      // Initial wallet creation starts with RM100.00 demo credit and non-negative balance
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.balance == 100
        && request.resource.data.isDemoWallet == true;

      // Prevent negative balances or arbitrary balance tampering outside transfer/topup limits
      allow update: if isSignedIn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && (
          // Owner updating PIN/settings or debiting/topping up within daily limit (RM500)
          (isOwner(userId) && (request.resource.data.balance - resource.data.balance) <= 500 && (resource.data.balance - request.resource.data.balance) <= 200) ||
          // Atomic peer transfer crediting receiver up to RM200 max per transfer
          (!isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt'])
            && (request.resource.data.balance > resource.data.balance)
            && (request.resource.data.balance - resource.data.balance) <= 200)
        );

      allow delete: if false;
    }

    // =========================================================================
    // 10. Demo Wallet Append-Only Ledger (Immutable, No Self-Transfer, Max RM200)
    // =========================================================================
    match /walletLedger/{ledgerId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.isDemoWallet == true
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.idempotencyKey is string
        && request.resource.data.idempotencyKey.size() >= 4
        && (
          // Peer-to-peer transfer: caller must be sender, cannot send to self, max RM200
          (request.resource.data.type == 'transfer'
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderId != request.resource.data.receiverId
            && request.resource.data.amount <= 200) ||
          // Simulated top-up: caller must be receiver, max RM500
          (request.resource.data.type == 'topup'
            && request.resource.data.receiverId == request.auth.uid
            && request.resource.data.amount <= 500)
        );

      // Ledger is strictly append-only
      allow update, delete: if false;
    }

    // =========================================================================
    // 11. Demo Wallet Money Requests & 50/50 Bill Splits
    // =========================================================================
    match /walletRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.payerId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterId != request.resource.data.payerId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 200
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && resource.data.payerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    // =========================================================================
    // 12. KampusKash Connect — Conversations & Real-Time Messages (Phase 2)
    // =========================================================================
    function hasNoForbiddenMessageBinaryKeys(data) {
      return !(data.keys().hasAny([
        'rawBytes', 'blob', 'fileBuffer', 'arrayBuffer', 'base64Data', 'binaryData', 'uint8Array'
      ]));
    }

    match /conversations/{conversationId} {
      // Only conversation participants can read or update conversation metadata
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.auth.uid in request.resource.data.participants;

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Only authenticated conversation participants can send messages as themselves,
        // without raw binary blobs inside Firestore documents
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.type in ['text', 'image', 'location', 'system', 'payment', 'voice', 'group_challenge']
          && hasNoForbiddenMessageBinaryKeys(request.resource.data);

        // Sender can soft-delete their own message; participants can update read receipts and reactions only
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == resource.data.senderId
          && hasNoForbiddenMessageBinaryKeys(request.resource.data)
          && (
            resource.data.senderId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'readAt', 'status', 'reactions', 'updatedAt'])
          );

        allow delete: if false;
      }
    }

    // =========================================================================
    // 13. KampusKash Connect — User Presence Mirror
    // =========================================================================
    match /userPresence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }
  }
}
