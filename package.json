{
  "name": "kampuskash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://airilakio29.github.io/KiroKash",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite\"",
    "server": "node server.js",
    "client": "vite",
    "build": "vite build",
    "build:gh-pages": "vite build --base=/KiroKash/",
    "predeploy": "npm run build:gh-pages",
    "deploy": "gh-pages -d dist",
    "test": "node --test test/theme.test.js test/phase1.test.js test/explore.test.js test/demo.test.js test/ai.test.js test/ai_intelligence.test.js test/ai_actions.test.js test/chat_overflow_and_action_confirmation.test.js test/responsive_ui_and_mobile_chat.test.js test/pwa.test.js",
    "test:theme": "node --test test/theme.test.js && node scripts/check-theme-contrast.mjs",
    "test:real-ai": "node --test test/real_gemini.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
